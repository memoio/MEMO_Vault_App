{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness converter ATIF-v1.7 text output subset",
  "$comment": "Locally authored output subset based on neulab/agent-data-protocol/schema/atif.py and Harbor ATIF RFC, consulted 2026-10-16. Not an upstream schema copy or full multimodal validator.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "session_id", "trajectory_id", "agent", "steps", "extra"],
  "properties": {
    "schema_version": {"const": "ATIF-v1.7"},
    "session_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"}, "version": {"type": "string"},
        "model_name": {"type": "string"}, "extra": {"type": "object"}
      }
    },
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "final_metrics": {"type": "object"}, "extra": {"type": "object"}
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "source", "message", "extra"],
      "properties": {
        "step_id": {"type": "integer", "minimum": 1},
        "source": {"enum": ["system", "user", "agent"]},
        "message": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"},
        "model_name": {"type": "string"}, "reasoning_effort": {"type": "string"},
        "reasoning_content": {"type": "string"}, "llm_call_count": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "array", "items": {"$ref": "#/$defs/tool_call"}},
        "observation": {
          "type": "object", "additionalProperties": false, "required": ["results"],
          "properties": {"results": {"type": "array", "items": {"$ref": "#/$defs/result"}}}
        },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "prompt_tokens": {"type": "integer", "minimum": 0},
            "completion_tokens": {"type": "integer", "minimum": 0},
            "cached_tokens": {"type": "integer", "minimum": 0},
            "extra": {"type": "object"}
          }
        },
        "extra": {"type": "object"}
      }
    },
    "tool_call": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_call_id", "function_name", "arguments", "extra"],
      "properties": {
        "tool_call_id": {"type": "string", "minLength": 1},
        "function_name": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"}, "extra": {"type": "object"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["source_call_id", "content", "extra"],
      "properties": {
        "source_call_id": {"type": "string", "minLength": 1},
        "content": {"type": "string"}, "extra": {"type": "object"}
      }
    }
  }
}
